{
  "name": "bactwin-wizard",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.2",
  "scripts": {
    "start": "pnpm --filter @bactwin/wizard start",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @bactwin/wizard test:e2e",
    "build": "pnpm -r --if-present build",
    "conformance": "pnpm --filter @bactwin/mapping-engine test",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/check-docs-links.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "markdown-it": "^15.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  }
}
