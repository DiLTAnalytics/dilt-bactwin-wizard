{
  "name": "@bactwin/wizard",
  "productName": "BACtwin Wizard",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiLTAnalytics/dilt-bactwin-wizard"
  },
  "description": "Translate BACnet data-point names onto the BACtwin naming standard",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "vitest run",
    "schema:write": "vitest run src/main/project/projectSchema.test.ts --update",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bactwin/mapping-engine": "workspace:*",
    "@bactwin/plugin-host": "workspace:*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.19",
    "fflate": "0.8.3",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.5",
    "write-excel-file": "4.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.17.1",
    "electron": "^44.7.2",
    "read-excel-file": "9.3.12",
    "rollup-plugin-license": "^3.7.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
